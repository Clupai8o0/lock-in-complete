# Copy to .env on the Pi and fill in real values.

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Arduino serial ---
# /dev/ttyACM0 = genuine Arduino, /dev/ttyUSB0 = CH340 clone (very common)
SERIAL_PORT=/dev/ttyUSB0
SERIAL_BAUD=115200

# --- Camera (Mac webcam HTTP server — see mac_camera/) ---
# Point this at the Mac running mac_camera_server.py.
# Find the Mac's LAN IP with `ipconfig getifaddr en0`.
CAMERA_URL=http://<mac-ip>:8081/capture
CAMERA_TIMEOUT_S=8

# --- timing ---
VISION_INTERVAL_S=75
FOCUS_CONFIRM_S=60
DEGRADING_TO_BREAK_S=120
AWAY_TIMEOUT_S=300
BREAK_TO_IDLE_S=600

# --- storage ---
DB_PATH=./data/lockin.db
IMAGE_DIR=./data/images
IMAGE_RETENTION_DAYS=7

# --- dashboard ---
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
